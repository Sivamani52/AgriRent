# =============================================================================
# AgriRent Backend Environment Configuration Template
# Duplicate this file as .env in the backend/ directory and supply valid values.
# NEVER commit the actual .env file or real secrets to version control.
# =============================================================================

# Server Configuration
PORT=5000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=agrirent

# JWT Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Brevo Transactional Email Configuration
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@agrirent.com
BREVO_SENDER_NAME=AgriRent

# Inspection Media Retention Configuration (30 days = 720 hours)
INSPECTION_MEDIA_RETENTION_HOURS=720
INSPECTION_MEDIA_BATCH_LIMIT=50
